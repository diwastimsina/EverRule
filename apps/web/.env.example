# Everything is optional locally. With nothing set, the demo runs on the sample
# incident, no password, no model, and shows the PR as a patch plus commands.

# Required on any public deployment. Gates the page and every API route.
DEMO_PASSWORD=

# demo (default) or llm. llm lets the model write the summary and first-draft
# rule, and allows uploads. Never on the public demo.
EVERRULE_MODE=
ANTHROPIC_API_KEY=
EVERRULE_MODEL=

# Set to open a real pull request. Fine-grained token scoped ONLY to the
# companion repo: Contents read/write, Pull requests read/write.
GITHUB_TOKEN=
GITHUB_REPO=diwastimsina/everrule-demo-procurement-service
GITHUB_BASE_BRANCH=main
