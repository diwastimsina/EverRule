# Everything is optional. With nothing set, or with DEMO_MODE=true, the demo runs in demo mode:
# the sample incident uses the built-in fixture and "Create GitHub PR" shows
# the patch and the commands to open the PR by hand.

# Set to let uploads of your own files call the model for the summary, rule and loopholes.
ANTHROPIC_API_KEY=

# Force demo mode even when keys are present.
DEMO_MODE=

# Set all three to turn "Create GitHub PR" into a real pull request.
# Use a fine-grained token scoped ONLY to the target repo:
# Contents read/write, Pull requests read/write. Never a classic token.
# (GITHUB_OWNER and GITHUB_BASE_BRANCH are accepted as aliases.)
GITHUB_TOKEN=
GITHUB_TARGET_OWNER=diwastimsina
GITHUB_TARGET_REPO=everrule-demo-procurement-service
GITHUB_TARGET_BASE=main
