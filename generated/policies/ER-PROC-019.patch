+// ER-PROC-019 v2. Generated by EverRule. SYNTHETIC demo.
+// Commitments to the same vendor totaling above $50,000 within 24 hours require a valid director approval for that order, issued before it and used once. Missing evidence means refuse.
+// Approved by J. Ellis, Director of Procurement Operations, 2026-09-16T00:00:00Z.
+// Rule hash (SHA-256 of the canonical rule JSON): 00640f604ecd29598861f0c3374600a0946c1b6a2a60f5dc52b4be828132d0b3
+import { procurementApi, type Approval, type PurchaseOrderRequest } from "./procurement-api";
+
+export const THRESHOLD_USD = 50000;
+export const WINDOW_HOURS = 24;
+
+export class PolicyViolation extends Error {
+  constructor(reason: string) {
+    super("ER-PROC-019: " + reason);
+    this.name = "PolicyViolation";
+  }
+}
+
+const hours = (a: string, b: string) => (new Date(a).getTime() - new Date(b).getTime()) / 3_600_000;
+
+export async function enforce(po: PurchaseOrderRequest): Promise<void> {
+  if (po.amount == null || !Number.isFinite(po.amount) || po.amount <= 0) {
+    throw new PolicyViolation("amount is missing or invalid (missing evidence)");
+  }
+  if (po.currency !== "USD") {
+    throw new PolicyViolation("a " + po.currency + " commitment cannot be evaluated against a USD rule");
+  }
+  // Concurrency: this read must happen inside the same serializable transaction
+  // as the insert, or under a per-vendor lock. Otherwise two concurrent orders
+  // can both read the old total and both pass.
+  const prior = await procurementApi.vendorCommitment(po.vendor_id, po.requested_at, WINDOW_HOURS);
+  const committed = prior + po.amount;
+  if (committed <= THRESHOLD_USD) return;
+
+  const a: Approval | undefined = po.approval;
+  if (!a) throw new PolicyViolation(`commitment $${committed} requires director approval`);
+  if (await procurementApi.approvalUsed(a.approval_id)) throw new PolicyViolation("approval was already used");
+  if (!a.valid) throw new PolicyViolation("approval is not valid");
+  if (a.approver_role !== "director") throw new PolicyViolation("approver is not a director");
+  if (a.approver_id === po.requester_id) throw new PolicyViolation("requester approved their own request");
+  if (a.vendor_id !== po.vendor_id) throw new PolicyViolation("approval is for a different vendor");
+  if (a.references_commitment !== null && a.references_commitment !== po.commitment_id) throw new PolicyViolation("approval is for a different order");
+  if (a.currency !== po.currency) throw new PolicyViolation("approval currency does not match");
+  if (a.amount_cap < committed) throw new PolicyViolation("approval cap is below the commitment");
+  if (hours(po.requested_at, a.issued_at) < 0) throw new PolicyViolation("approval was issued after the order");
+  if (hours(a.expires_at, po.requested_at) <= 0) throw new PolicyViolation("approval had expired");
+}
