+import { enforce, PolicyViolation } from "./procurement-policy";
+
+const T0 = Date.UTC(2026, 7, 17, 14, 0, 0);
+const at = (h: number) => new Date(T0 + h * 3_600_000).toISOString();
+
+  test("[incident] the recorded incident: $78,000 with no approval", async () => {
+    procurementApi.__reset({ prior: [], used: [] });
+    const po: PurchaseOrderRequest = { requester_id: "procurement-agent", vendor_id: "VEND-2291", amount: 78000, currency: "USD", requested_at: at(0), approval: undefined };
+    await assert.rejects(enforce(po), PolicyViolation);
+  });
+
+  test("[legitimate] $12,000 with no approval", async () => {
+    procurementApi.__reset({ prior: [], used: [] });
+    const po: PurchaseOrderRequest = { requester_id: "procurement-agent", vendor_id: "VEND-2291", amount: 12000, currency: "USD", requested_at: at(0), approval: undefined };
+    await assert.doesNotReject(enforce(po));
+  });
+
+  test("[legitimate] $78,000 with a valid director approval", async () => {
+    procurementApi.__reset({ prior: [], used: [] });
+    const po: PurchaseOrderRequest = { requester_id: "procurement-agent", vendor_id: "VEND-2291", amount: 78000, currency: "USD", requested_at: at(0), approval: { approval_id: "APR-2001", approver_id: "dir-ellis", approver_role: "director", vendor_id: "VEND-2291", amount_cap: 80000, currency: "USD", issued_at: at(-2), expires_at: at(72) } };
+    await assert.doesNotReject(enforce(po));
+  });
+
+  test("[prohibited] $78,000 with no approval", async () => {
